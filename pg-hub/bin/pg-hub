#!/usr/bin/env python3
"""pg-hub — central Postgres dev-container manager.

One container per project, each on a distinct host port. Source of truth is
projects.yaml; docker-compose.yml is regenerated from it.
"""
from __future__ import annotations

import argparse
import json
import socket
import subprocess
import sys
import time
from pathlib import Path

try:
    import yaml
except ImportError:
    sys.stderr.write(
        "pg-hub requires PyYAML. Install with one of:\n"
        "  pipx install pyyaml   # or\n"
        "  uv tool install pyyaml\n"
        "  pip install --user pyyaml\n"
    )
    sys.exit(2)

HUB_ROOT = Path(__file__).resolve().parent.parent
PROJECTS_FILE = HUB_ROOT / "projects.yaml"
COMPOSE_FILE = HUB_ROOT / "docker-compose.yml"
DEFAULT_IMAGE = "postgres:17-alpine"


def load_projects() -> dict:
    if not PROJECTS_FILE.exists():
        return {
            "version": 1,
            "port_range": [5433, 5500],
            "postgres_image": DEFAULT_IMAGE,
            "projects": {},
        }
    return yaml.safe_load(PROJECTS_FILE.read_text()) or {}


def save_projects(data: dict) -> None:
    PROJECTS_FILE.write_text(
        yaml.safe_dump(data, sort_keys=False, default_flow_style=False)
    )


def port_is_bindable(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def next_free_port(data: dict) -> int:
    used = {p["port"] for p in data.get("projects", {}).values()}
    lo, hi = data.get("port_range", [5433, 5500])
    for p in range(lo, hi + 1):
        if p in used:
            continue
        if port_is_bindable(p):
            return p
    raise RuntimeError(f"no free port in range {lo}-{hi}")


def render_compose(data: dict) -> str:
    image = data.get("postgres_image", DEFAULT_IMAGE)
    lines: list[str] = [
        "# GENERATED by pg-hub from projects.yaml — do not edit by hand.",
        "# Modify projects.yaml (or use `pg-hub claim/release`) then `pg-hub regen`.",
        "",
        "services:",
    ]
    volumes: list[str] = []
    for name, cfg in data.get("projects", {}).items():
        vol = cfg.get("volume", f"pg-hub-{name}")
        volumes.append(vol)
        lines += [
            f"  pg-{name}:",
            f"    image: {image}",
            f"    container_name: pg-hub-{name}",
            f'    ports: ["{cfg["port"]}:5432"]',
            "    environment:",
            f"      POSTGRES_DB: {cfg['database']}",
            f"      POSTGRES_USER: {cfg['user']}",
            f"      POSTGRES_PASSWORD: {cfg['password']}",
            "    volumes:",
            f"      - {vol}:/var/lib/postgresql/data",
            "    healthcheck:",
            f'      test: ["CMD-SHELL", "pg_isready -U {cfg["user"]} -d {cfg["database"]}"]',
            "      interval: 5s",
            "      timeout: 3s",
            "      retries: 10",
            "    restart: unless-stopped",
            "",
        ]
    if volumes:
        lines.append("volumes:")
        for v in volumes:
            lines.append(f"  {v}:")
    return "\n".join(lines) + "\n"


def regen_compose(data: dict) -> None:
    COMPOSE_FILE.write_text(render_compose(data))


def running_containers() -> set[str]:
    try:
        out = subprocess.check_output(
            ["docker", "ps", "--format", "{{.Names}}"], text=True
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return set()
    return {line.strip() for line in out.splitlines() if line.strip()}


def env_payload(name: str, cfg: dict) -> dict:
    return {
        "name": name,
        "host": "localhost",
        "port": cfg["port"],
        "database": cfg["database"],
        "user": cfg["user"],
        "password": cfg["password"],
        "url": (
            f"postgresql://{cfg['user']}:{cfg['password']}"
            f"@localhost:{cfg['port']}/{cfg['database']}"
        ),
        "container": f"pg-hub-{name}",
    }


def render_env(name: str, cfg: dict, fmt: str) -> str:
    p = env_payload(name, cfg)
    if fmt == "dotenv":
        return (
            f"# pg-hub: project '{name}' — copy into your project's .env\n"
            f"POSTGRES_HOST={p['host']}\n"
            f"POSTGRES_PORT={p['port']}\n"
            f"POSTGRES_DB={p['database']}\n"
            f"POSTGRES_USER={p['user']}\n"
            f"POSTGRES_PASSWORD={p['password']}\n"
            f"DATABASE_URL={p['url']}\n"
        )
    if fmt == "export":
        return (
            f"export POSTGRES_HOST={p['host']}\n"
            f"export POSTGRES_PORT={p['port']}\n"
            f"export POSTGRES_DB={p['database']}\n"
            f"export POSTGRES_USER={p['user']}\n"
            f"export POSTGRES_PASSWORD={p['password']}\n"
            f"export DATABASE_URL='{p['url']}'\n"
        )
    if fmt == "json":
        return json.dumps(p, indent=2) + "\n"
    if fmt == "compose-fragment":
        return (
            f"# pg-hub: reference for project '{name}'.\n"
            f"# Add to your project's docker-compose.yml so app containers can\n"
            f"# reach the hub via host.docker.internal.\n"
            f"# environment:\n"
            f"#   POSTGRES_HOST: host.docker.internal\n"
            f"#   POSTGRES_PORT: \"{p['port']}\"\n"
            f"#   POSTGRES_DB: {p['database']}\n"
            f"#   POSTGRES_USER: {p['user']}\n"
            f"#   POSTGRES_PASSWORD: {p['password']}\n"
            f"# extra_hosts:\n"
            f"#   - \"host.docker.internal:host-gateway\"\n"
        )
    raise ValueError(f"unknown env format: {fmt}")


def cmd_claim(args: argparse.Namespace) -> None:
    data = load_projects()
    projects = data.setdefault("projects", {})
    if args.name in projects:
        if args.if_missing:
            print(
                f"already claimed: '{args.name}' on port "
                f"{projects[args.name]['port']}"
            )
            print(render_env(args.name, projects[args.name], "dotenv"), end="")
            return
        sys.exit(
            f"error: project '{args.name}' already claimed "
            f"(port {projects[args.name]['port']})"
        )
    port = args.port or next_free_port(data)
    if not port_is_bindable(port):
        print(
            f"warning: host port {port} is not bindable right now — "
            "another process may be holding it",
            file=sys.stderr,
        )
    slug = args.name.replace("-", "_")
    projects[args.name] = {
        "port": port,
        "database": args.db or slug,
        "user": args.user or slug,
        "password": args.password or f"{slug}_dev",
        "volume": f"pg-hub-{args.name}",
    }
    save_projects(data)
    regen_compose(data)
    print(f"claimed '{args.name}' on port {port}\n")
    print(render_env(args.name, projects[args.name], "dotenv"), end="")


def cmd_release(args: argparse.Namespace) -> None:
    data = load_projects()
    projects = data.get("projects", {})
    if args.name not in projects:
        sys.exit(f"error: no project '{args.name}'")
    subprocess.run(
        ["docker", "compose", "-f", str(COMPOSE_FILE),
         "rm", "-sf", f"pg-{args.name}"],
        check=False,
    )
    if args.purge:
        vol = projects[args.name].get("volume", f"pg-hub-{args.name}")
        subprocess.run(
            ["docker", "volume", "rm", f"pg-hub_{vol}"],
            check=False,
        )
    del projects[args.name]
    save_projects(data)
    regen_compose(data)
    print(f"released '{args.name}'" + (" (volume purged)" if args.purge else ""))


def cmd_list(args: argparse.Namespace) -> None:
    data = load_projects()
    projects = data.get("projects", {})
    if not projects:
        print("(no projects claimed — use `pg-hub claim <name>`)")
        return
    running = running_containers()
    print(f"{'NAME':<20} {'PORT':<6} {'DATABASE':<22} {'USER':<18} STATUS")
    for name, cfg in projects.items():
        status = "running" if f"pg-hub-{name}" in running else "stopped"
        print(
            f"{name:<20} {cfg['port']:<6} {cfg['database']:<22} "
            f"{cfg['user']:<18} {status}"
        )


def _compose_cmd(action: str, names: list[str], extra: list[str] | None = None) -> None:
    if not COMPOSE_FILE.exists():
        sys.exit("error: docker-compose.yml missing — run `pg-hub regen` first")
    svcs = [f"pg-{n}" for n in names]
    cmd = ["docker", "compose", "-f", str(COMPOSE_FILE), action]
    if extra:
        cmd += extra
    cmd += svcs
    subprocess.run(cmd, check=True)


def cmd_up(args: argparse.Namespace) -> None:
    _compose_cmd("up", args.names or [], extra=["-d"])


def cmd_down(args: argparse.Namespace) -> None:
    if args.names:
        _compose_cmd("stop", args.names)
    else:
        subprocess.run(
            ["docker", "compose", "-f", str(COMPOSE_FILE), "down"],
            check=True,
        )


def cmd_psql(args: argparse.Namespace) -> None:
    data = load_projects()
    cfg = data.get("projects", {}).get(args.name)
    if not cfg:
        sys.exit(f"error: no project '{args.name}'")
    subprocess.run(
        ["docker", "exec", "-it", f"pg-hub-{args.name}",
         "psql", "-U", cfg["user"], "-d", cfg["database"]]
    )


def cmd_env(args: argparse.Namespace) -> None:
    data = load_projects()
    cfg = data.get("projects", {}).get(args.name)
    if not cfg:
        sys.exit(f"error: no project '{args.name}'")
    sys.stdout.write(render_env(args.name, cfg, args.format))


def container_health(name: str) -> str:
    """Return 'healthy' / 'unhealthy' / 'starting' / 'absent' / 'stopped'."""
    try:
        out = subprocess.check_output(
            ["docker", "inspect", "--format",
             "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}",
             f"pg-hub-{name}"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return "absent"
    state, health = (out.split("|", 1) + ["none"])[:2]
    if state != "running":
        return "stopped"
    if health in ("healthy", "unhealthy", "starting"):
        return health
    return "running"


def wait_healthy(name: str, timeout: float = 30.0) -> str:
    deadline = time.monotonic() + timeout
    last = "absent"
    while time.monotonic() < deadline:
        last = container_health(name)
        if last in ("healthy", "running"):
            return last
        if last == "unhealthy":
            return last
        time.sleep(0.5)
    return last


def cmd_ensure(args: argparse.Namespace) -> None:
    """Idempotent: claim if missing, start, wait healthy, print env."""
    data = load_projects()
    projects = data.setdefault("projects", {})
    if args.name not in projects:
        port = args.port or next_free_port(data)
        slug = args.name.replace("-", "_")
        projects[args.name] = {
            "port": port,
            "database": args.db or slug,
            "user": args.user or slug,
            "password": args.password or f"{slug}_dev",
            "volume": f"pg-hub-{args.name}",
        }
        save_projects(data)
        regen_compose(data)
        print(f"claimed '{args.name}' on port {port}", file=sys.stderr)
    cfg = projects[args.name]
    if not COMPOSE_FILE.exists():
        regen_compose(data)
    subprocess.run(
        ["docker", "compose", "-f", str(COMPOSE_FILE),
         "up", "-d", f"pg-{args.name}"],
        check=True,
    )
    status = wait_healthy(args.name, timeout=args.timeout)
    if status not in ("healthy", "running"):
        sys.exit(f"error: '{args.name}' did not become healthy ({status})")
    print(f"ready: '{args.name}' ({status}) on port {cfg['port']}", file=sys.stderr)
    sys.stdout.write(render_env(args.name, cfg, args.format))


def docker_inspect_port(name: str) -> int | None:
    try:
        out = subprocess.check_output(
            ["docker", "inspect", "--format",
             "{{(index (index .NetworkSettings.Ports \"5432/tcp\") 0).HostPort}}",
             f"pg-hub-{name}"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    try:
        return int(out)
    except ValueError:
        return None


def docker_volume_exists(volume: str) -> bool:
    try:
        subprocess.check_output(
            ["docker", "volume", "inspect", f"pg-hub_{volume}"],
            stderr=subprocess.DEVNULL,
        )
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def doctor_checks(data: dict) -> list[dict]:
    checks: list[dict] = []

    def add(level: str, name: str, msg: str) -> None:
        checks.append({"level": level, "name": name, "message": msg})

    projects = data.get("projects", {}) or {}
    lo, hi = data.get("port_range", [5433, 5500])

    # 1. yaml integrity
    seen_ports: dict[int, str] = {}
    for pname, cfg in projects.items():
        port = cfg.get("port")
        if port is None:
            add("fail", f"yaml/{pname}", "missing port")
            continue
        if not (lo <= port <= hi):
            add("fail", f"yaml/{pname}",
                f"port {port} outside range {lo}-{hi}")
        if port in seen_ports:
            add("fail", f"yaml/{pname}",
                f"port {port} collides with '{seen_ports[port]}'")
        seen_ports[port] = pname
        for field in ("database", "user", "password", "volume"):
            if not cfg.get(field):
                add("fail", f"yaml/{pname}", f"missing {field}")

    # 2. compose drift
    rendered = render_compose(data)
    if not COMPOSE_FILE.exists():
        add("fail", "compose/exists",
            "docker-compose.yml missing — run `pg-hub regen`")
    else:
        on_disk = COMPOSE_FILE.read_text()
        if on_disk != rendered:
            add("fail", "compose/drift",
                "docker-compose.yml differs from projects.yaml — "
                "run `pg-hub regen` (do not hand-edit)")
        else:
            add("ok", "compose/drift", "compose matches yaml")

    # 3. per-project container state
    for pname, cfg in projects.items():
        health = container_health(pname)
        if health == "absent":
            add("warn", f"container/{pname}",
                "no container (run `pg-hub up`)")
            continue
        if health == "stopped":
            add("warn", f"container/{pname}", "container stopped")
            continue
        if health == "unhealthy":
            add("fail", f"container/{pname}", "container unhealthy")
            continue
        add("ok", f"container/{pname}", f"container {health}")
        actual = docker_inspect_port(pname)
        if actual is None:
            add("warn", f"port/{pname}", "could not read host port")
        elif actual != cfg.get("port"):
            add("fail", f"port/{pname}",
                f"declared {cfg['port']} but container exposes {actual}")
        else:
            add("ok", f"port/{pname}", f"port {actual} matches yaml")

    # 4. volumes
    for pname, cfg in projects.items():
        vol = cfg.get("volume", f"pg-hub-{pname}")
        if docker_volume_exists(vol):
            add("ok", f"volume/{pname}", f"{vol} present")
        else:
            add("warn", f"volume/{pname}",
                f"volume pg-hub_{vol} not yet created")

    # 5. foreign occupants in port_range
    declared_ports = {cfg.get("port") for cfg in projects.values()}
    for port in range(lo, hi + 1):
        if port in declared_ports:
            continue
        if not port_is_bindable(port):
            add("warn", f"port/foreign-{port}",
                f"port {port} bound by non-hub process")

    return checks


def cmd_doctor(args: argparse.Namespace) -> None:
    data = load_projects()
    checks = doctor_checks(data)
    fails = sum(1 for c in checks if c["level"] == "fail")
    warns = sum(1 for c in checks if c["level"] == "warn")
    if args.json:
        print(json.dumps(
            {"fails": fails, "warns": warns, "checks": checks}, indent=2,
        ))
    else:
        symbols = {"ok": "✓", "warn": "!", "fail": "✗"}
        for c in checks:
            print(f"  {symbols.get(c['level'], '?')} "
                  f"{c['name']:<28} {c['message']}")
        print(f"\n{fails} fail, {warns} warn, "
              f"{sum(1 for c in checks if c['level'] == 'ok')} ok")
    sys.exit(1 if fails else 0)


def cmd_regen(args: argparse.Namespace) -> None:
    regen_compose(load_projects())
    print(f"regenerated {COMPOSE_FILE}")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="pg-hub",
        description="Central Postgres dev-container manager (one per project).",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sc = sub.add_parser("claim", help="Reserve a Postgres container for a project")
    sc.add_argument("name")
    sc.add_argument("--port", type=int, help="pin a specific host port")
    sc.add_argument("--db", help="database name (default: project name)")
    sc.add_argument("--user", help="db user (default: project name)")
    sc.add_argument("--password", help="db password (default: <name>_dev)")
    sc.add_argument("--if-missing", action="store_true", dest="if_missing",
                    help="exit 0 (no-op) if already claimed instead of erroring")
    sc.set_defaults(func=cmd_claim)

    sr = sub.add_parser("release", help="Remove a project allocation")
    sr.add_argument("name")
    sr.add_argument("--purge", action="store_true",
                    help="also delete the Docker volume (destroys data)")
    sr.set_defaults(func=cmd_release)

    for verb in ("list", "status"):
        sx = sub.add_parser(verb, help="List claimed projects and container status")
        sx.set_defaults(func=cmd_list)

    su = sub.add_parser("up", help="Start project container(s); all if none given")
    su.add_argument("names", nargs="*")
    su.set_defaults(func=cmd_up)

    sd = sub.add_parser("down", help="Stop project container(s); all if none given")
    sd.add_argument("names", nargs="*")
    sd.set_defaults(func=cmd_down)

    sp = sub.add_parser("psql", help="Open psql inside the project's container")
    sp.add_argument("name")
    sp.set_defaults(func=cmd_psql)

    se = sub.add_parser("env", help="Print env-var snippet for the project")
    se.add_argument("name")
    se.add_argument("--format", choices=["dotenv", "json", "export", "compose-fragment"],
                    default="dotenv", help="output format (default: dotenv)")
    se.set_defaults(func=cmd_env)

    sn = sub.add_parser(
        "ensure",
        help="Idempotent: claim if missing, start, wait healthy, print env",
    )
    sn.add_argument("name")
    sn.add_argument("--port", type=int)
    sn.add_argument("--db")
    sn.add_argument("--user")
    sn.add_argument("--password")
    sn.add_argument("--timeout", type=float, default=30.0,
                    help="seconds to wait for healthy (default: 30)")
    sn.add_argument("--format", choices=["dotenv", "json", "export", "compose-fragment"],
                    default="dotenv")
    sn.set_defaults(func=cmd_ensure)

    sdoc = sub.add_parser(
        "doctor",
        help="Self-assess: yaml integrity, compose drift, container/port/volume state",
    )
    sdoc.add_argument("--json", action="store_true",
                      help="emit machine-readable JSON")
    sdoc.set_defaults(func=cmd_doctor)

    sg = sub.add_parser("regen", help="Regenerate docker-compose.yml from projects.yaml")
    sg.set_defaults(func=cmd_regen)

    return p


def main() -> None:
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
